PROCESS BEFORE OUTPUT.
 MODULE LISTE_INITIALISIEREN.
 LOOP AT EXTRACT WITH CONTROL
  TCTRL_ZTB_PRODUTOS CURSOR NEXTLINE.
   MODULE LISTE_SHOW_LISTE.
 ENDLOOP.
*
PROCESS AFTER INPUT.
 MODULE LISTE_EXIT_COMMAND AT EXIT-COMMAND.
 MODULE LISTE_BEFORE_LOOP.
 LOOP AT EXTRACT.
   MODULE LISTE_INIT_WORKAREA.
   CHAIN.
    FIELD ZTB_PRODUTOS-ID_PROD .
    FIELD ZTB_PRODUTOS-NOME .
    FIELD ZTB_PRODUTOS-DESCRICAO .
    FIELD ZTB_PRODUTOS-CATEGORIA .
    FIELD ZTB_PRODUTOS-PRECO .
    FIELD ZTB_PRODUTOS-MOEDA .
    FIELD ZTB_PRODUTOS-UNIDADE_MEDIDA .
    FIELD ZTB_PRODUTOS-QTD_MIN .
    FIELD ZTB_PRODUTOS-STATUS .
    FIELD ZTB_PRODUTOS-DATA_CRIACAO .
    MODULE SET_UPDATE_FLAG ON CHAIN-REQUEST.
   ENDCHAIN.
   FIELD VIM_MARKED MODULE LISTE_MARK_CHECKBOX.
   CHAIN.
    FIELD ZTB_PRODUTOS-ID_PROD .
    MODULE LISTE_UPDATE_LISTE.
   ENDCHAIN.
 ENDLOOP.
 MODULE LISTE_AFTER_LOOP.
